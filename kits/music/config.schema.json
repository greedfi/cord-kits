{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/greedfi/cord-kits/blob/main/kits/music/config.schema.json",
  "title": "Music kit config",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultVolume", "maxQueueSize", "extendedQueue", "autoplay", "stayConnected", "filter", "guilds"],
  "properties": {
    "defaultVolume": { "type": "integer", "minimum": 0, "maximum": 100 },
    "maxQueueSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "extendedQueue": { "type": "boolean" },
    "autoplay": { "type": "boolean" },
    "stayConnected": { "type": "boolean" },
    "filter": { "enum": ["off", "bassboost", "nightcore", "8d"] },
    "guilds": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]{17,20}$" },
      "additionalProperties": { "$ref": "#/$defs/guild" }
    }
  },
  "$defs": {
    "guild": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultVolume": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxQueueSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "extendedQueue": { "type": "boolean" },
        "autoplay": { "type": "boolean" },
        "stayConnected": { "type": "boolean" },
        "filter": { "enum": ["off", "bassboost", "nightcore", "8d"] },
        "djRoleId": { "type": ["string", "null"], "pattern": "^[0-9]{17,20}$" },
        "djOnly": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "play", "playskip", "playtop", "search", "pause", "resume", "skip", "back",
              "replay", "stop", "loop", "shuffle", "move", "remove", "clear", "seek",
              "forward", "rewind", "volume", "join", "leave", "sleep", "filter", "playlist"
            ]
          }
        },
        "textChannels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]{17,20}$" }
        },
        "voiceChannels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]{17,20}$" }
        },
        "requestChannelId": { "type": ["string", "null"], "pattern": "^[0-9]{17,20}$" },
        "requestAutoDelete": { "type": "boolean" },
        "requestCommandsOnly": { "type": "boolean" }
      }
    }
  }
}
