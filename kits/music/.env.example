DISCORD_BOT_TOKEN=
CLIENT_ID=
# Set this to register slash commands to one server while developing.
# Leave it unset to register global commands.
GUILD_ID=
# Optional public SoundCloud client id. The bot can also discover one at runtime.
SOUNDCLOUD_CLIENT_ID=
# Set to true to enable the song-request channel. This adds the privileged Message Content intent.
ENABLE_REQUEST_CHANNEL=
# Directory for playlists and 24/7 state. Defaults to ./data. Mount a volume in production.
DATA_DIR=
# Optional path to the config file. Defaults to ./config.json.
CONFIG_PATH=
# Optional ffmpeg executable. Defaults to ffmpeg on PATH.
FFMPEG_PATH=
