DISCORD_BOT_TOKEN=
CLIENT_ID=
# Set this to register slash commands to one server while developing.
# Leave it unset to register global commands.
GUILD_ID=
# Optional public SoundCloud client id. The bot can also discover one at runtime.
SOUNDCLOUD_CLIENT_ID=
# Set to 1 to enable the song-request channel. Also enable Message Content in the Developer Portal.
# Leave unset to keep the gateway connection free of privileged intents.
ENABLE_REQUEST_CHANNEL=
# Runtime state (playlists, 24/7 rejoin, lock). Not baked into the image. Use a persistent volume.
DATA_DIR=
